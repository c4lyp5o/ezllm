# claude-bridge — sidecar that drives the official Claude Code CLI against a
# Claude subscription. See docs/claude-subscription-design.md.
#
# The CLI binary is deliberately NOT baked into this image:
#   * it is a 265 MB native binary with its own release cadence, and
#   * keeping it out means this image stays distroless-static and CI-buildable.
# The operator mounts a pinned CLI binary read-only (compose.claude-bridge.yml),
# and boot asserts its version and flag surface before serving.

# ── Stage 1: build ───────────────────────────────────────────────────────────
FROM golang:1.27-alpine AS builder
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath \
      -ldflags="-s -w" \
      -o /out/claude-bridge ./cmd/claude-bridge

# Static, or distroless has nothing to run it with.
RUN apk add --no-cache file >/dev/null 2>&1 \
 && file /out/claude-bridge | grep -q "statically linked" \
 && echo "OK: statically linked -> distroless-safe" \
 || { echo "FATAL: binary is not static; distroless runtime will fail"; exit 1; }

# ── Stage 2: runtime ────────────────────────────────────────────────────────
# :nonroot carries CA certs (the CLI needs them for api.anthropic.com) but no
# shell. Health is probed from outside the container.
FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=builder /out/claude-bridge /app/claude-bridge

WORKDIR /app

# Mount points only: the CLI binary (ro) and the subscription login (rw, because
# the CLI refreshes its own token there). Never bake either into an image.
#   /opt/claude/claude   <- pinned official CLI binary
#   /claude-sub          <- CLAUDE_CONFIG_DIR with .credentials.json
ENV CLAUDE_BRIDGE_CLI=/opt/claude/claude
ENV CLAUDE_BRIDGE_CONFIG_DIR=/claude-sub

# USER/LOGNAME are required: the CLI's local login check reads process identity
# and reports logged-out instantly without them. The compose file sets them to
# the account that owns the mounted login directory.
EXPOSE 8790

ENTRYPOINT ["/app/claude-bridge"]
CMD ["-claude-bin", "/opt/claude/claude", "-claude-config-dir", "/claude-sub", "-addr", "0.0.0.0:8790"]
